{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Compiler demo_matrices",
            "command": "gcc",
            "args": [
                "-std=c11",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-g",
                "main.c",
                "matrice.c",
                "matrice_alloc.c",
                "matrice_io.c",
                "matrice_calcul.c",
                "-o",
                "demo_matrices.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}/td_matrices"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}